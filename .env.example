# ==========================================================================
# ParkWise environment configuration
# Copy this file to `.env` (used by the API + Prisma) and fill in real values.
# The frontend reads VITE_* values from this same file via Vite's envDir.
# ==========================================================================

# --- Core URLs -------------------------------------------------------------
CLIENT_URL="http://localhost:3000"
API_URL="http://localhost:4000"
PORT="4000"
NODE_ENV="development"

# --- Database (Prisma) -----------------------------------------------------
# Prisma reads DATABASE_URL directly. The docker-compose Postgres below uses
# user=parkwise password=parkwise db=parkwise. If you use a native Postgres,
# point this at it instead.
DATABASE_URL="postgresql://parkwise:parkwise@localhost:5432/parkwise?schema=public"

# Used by docker-compose.yml to provision the Postgres container.
POSTGRES_USER="parkwise"
POSTGRES_PASSWORD="parkwise"
POSTGRES_DB="parkwise"
POSTGRES_PORT="5432"

# --- Auth & security -------------------------------------------------------
# Long random strings. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS="168"
# 32-byte key (base64 or hex) used to encrypt API integration tokens at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
# Set to "true" only behind HTTPS (production). Marks the session cookie Secure.
COOKIE_SECURE="false"

# --- Seeded system administrator ------------------------------------------
SYS_ADMIN_EMAIL="sysadmin@parkwise.local"
SYS_ADMIN_PASSWORD="ParkWiseAdmin123!"
SYS_ADMIN_NAME="System Admin"

# --- Maps & navigation (frontend + backend) -------------------------------
# Leave blank to use the free OpenFreeMap vector basemap (no key required).
# For sharper tiles, get a free key at maptiler.com.
VITE_MAPTILER_KEY=""
# Optional: any MapLibre style JSON URL to override the basemap.
VITE_MAP_STYLE_URL=""
# OSRM-compatible routing server for road-following navigation. Leave blank to
# use the built-in straight-line estimate (the public OSRM demo at
# router.project-osrm.org is often unreachable). Point at a reachable/self-hosted
# OSRM server for real road routes.
ROUTING_PROVIDER_URL=""

# --- Frontend dev proxy ----------------------------------------------------
VITE_API_PROXY_TARGET="http://localhost:4000"
